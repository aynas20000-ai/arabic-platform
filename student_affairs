========================= */

function toArabicNumber(
  value
){

  return String(
    value
  ).replace(
    /\d/g,
    digit =>
      "٠١٢٣٤٥٦٧٨٩"[digit]
  );

}


function safeNumber(
  value
){

  const number =
    Number(
      value
    );


  return Number.isFinite(
    number
  )
    ? number
    : 0;

}


function escapeHtml(
  value
){

  return String(
    value ?? ""
  )
  .replaceAll(
    "&",
    "&amp;"
  )
  .replaceAll(
    "<",
    "&lt;"
  )
  .replaceAll(
    ">",
    "&gt;"
  )
  .replaceAll(
    '"',
    "&quot;"
  )
  .replaceAll(
    "'",
    "&#039;"
  );

}


function normalizeClassName(
  value
){

  const text =
    String(
      value || ""
    )
    .trim()
    .replace(
      /\s+/g,
      " "
    );


  if(!text){
    return "غير محدد";
  }


  if(
    text === "أ" ||
    text === "ا" ||
    text.includes("متوسط أ") ||
    text.includes("متوسط ا") ||
    text.includes("ثالث أ")
  ){

    return "ثالث متوسط أ";

  }


  if(
    text === "ب" ||
    text.includes("متوسط ب") ||
    text.includes("ثالث ب")
  ){

    return "ثالث متوسط ب";

  }


  if(
    text === "ج" ||
    text.includes("متوسط ج") ||
    text.includes("ثالث ج")
  ){

    return "ثالث متوسط ج";

  }


  return text;

}


function getBestPercentage(
  test
){

  if(
    !test ||
    typeof test !== "object"
  ){

    return 0;

  }


  const best =
    Number(
      test["أفضل_نسبة"]
    );


  if(
    Number.isFinite(
      best
    )
  ){

    return best;

  }


  const percentage =
    Number(
      test["النسبة"]
    );


  return Number.isFinite(
    percentage
  )
    ? percentage
    : 0;

}


function scoreClass(
  value
){

  if(value >= 80){
    return "score-good";
  }


  if(value >= 60){
    return "score-mid";
  }


  return "score-low";

}


/* =========================
   تجهيز بيانات الطالبة
========================= */

function prepareStudentData(
  id,
  data
){

  const semester1Result =
    data?.["نتيجة_الفصل_الأول"] ||
    {};


  const semester2Result =
    data?.["نتيجة_الفصل_الثاني"] ||
    {};


  const semester1Tests =
    data?.["اختبارات_الفصل_الأول"] ||
    {};


  const semester2Tests =
    data?.["اختبارات_الفصل_الثاني"] ||
    {};


  const semester2CompletedModels =
    Object.values(
      semester2Tests
    )
    .filter(
      item =>
        item &&
        typeof item === "object" &&
        item["مكتمل"] === true
    );


  const semester2Average =
    semester2CompletedModels.length > 0

      ? Math.round(
          semester2CompletedModels.reduce(
            (
              total,
              item
            ) =>
              total +
              getBestPercentage(
                item
              ),
            0
          ) /
          semester2CompletedModels.length
        )

      : 0;


  const nafes =
    data?.["نافس_المتابعة"] ||
    {};


  const challengeResults =
    nafes["نتائج_التحديات"] &&
    typeof nafes[
      "نتائج_التحديات"
    ] === "object"

      ? nafes[
          "نتائج_التحديات"
        ]

      : {};


  let challengeCount =
    0;


  let challengeTotal =
    0;


  let certificateCount =
    0;


  for(
    let number=1;
    number<=TOTAL_CHALLENGES;
    number++
  ){

    const item =
      challengeResults[
        `challenge${number}`
      ] ||
      challengeResults[
        `challenge${String(number).padStart(2,"0")}`
      ];


    if(
      !item ||
      typeof item !== "object"
    ){

      continue;

    }


    const score =
      safeNumber(
        item["الدرجة"] ??
        item.score
      );


    const total =
      safeNumber(
        item["المجموع"] ??
        item.total ??
        10
      );


    let percentage =
      Number(
        item["النسبة"] ??
        item.percentage
      );


    if(
      !Number.isFinite(
        percentage
      )
    ){

      percentage =
        total > 0
          ? Math.round(
              score /
              total *
              100
            )
          : 0;

    }


    percentage =
      Math.max(
        0,
        Math.min(
          100,
          Math.round(
            percentage
          )
        )
      );


    challengeCount++;


    challengeTotal +=
      percentage;


    if(
      item["الشهادة"] === true ||
      item.certificate === true ||
      percentage >= 80
    ){

      certificateCount++;

    }

  }


  const challengeAverage =
    challengeCount > 0

      ? Math.round(
          challengeTotal /
          challengeCount
        )

      : 0;


  const cup =
    challengeCount ===
      TOTAL_CHALLENGES &&
    challengeAverage >= 80;


  return {

    id,

    name:
      data?.["الاسم_الرباعي"] ||
      data?.["الاسم الرباعي"] ||
      data?.["الاسم_الكامل"] ||
      data?.["الاسم الكامل"] ||
      data?.["اسم_الطالبة"] ||
      data?.["الاسم"] ||
      "طالبة غير مسماة",

    className:
      normalizeClassName(
        data?.["الفصل"]
      ),

    semester1:{

      completed:
        semester1Result[
          "مكتمل"
        ] === true,

      score:
        safeNumber(
          semester1Result[
            "الدرجة"
          ]
        ),

      certificate:
        semester1Result[
          "استحقت_الشهادة"
        ] === true,

      testCount:
        Object.values(
          semester1Tests
        )
        .filter(
          item =>
            item &&
            typeof item === "object"
        )
        .length

    },


    semester2:{

      completed:
        semester2Result[
          "مكتمل"
        ] === true,

      score:
        safeNumber(
          semester2Result[
            "الدرجة"
          ]
        ),

      certificate:
        semester2Result[
          "استحقت_الشهادة"
        ] === true,

      testCount:
        semester2CompletedModels.length,

      currentAverage:
        semester2Average

    },


    nafes:{

      viewed:
        nafes["اطلعت"] === true,

      challengeCount,

      challengeAverage,

      certificateCount,

      cup

    }

  };

}
/* =========================
   تحميل الطالبات
========================= */

async function loadStudents(){

  statusBox.style.display =
    "block";


  statusBox.className =
    "status-box loading";


  statusBox.textContent =
    "جارٍ تحميل بيانات الطالبات...";


  try{

    const snapshot =
      await getDocs(
        collection(
          db,
          "students"
        )
      );


    allStudents =
      [];


    snapshot.forEach(
      documentSnapshot => {

        if(
          documentSnapshot.id ===
          TEACHER_UID
        ){

          return;

        }


        const data =
          documentSnapshot.data();


        if(
          !data?.["الاسم"] &&
          !data?.["اسم_الطالبة"] &&
          !data?.["الاسم_الرباعي"] &&
          !data?.["معرف_المستخدم"]
        ){

          return;

        }


        allStudents.push(
          prepareStudentData(
            documentSnapshot.id,
            data
          )
        );

      }
    );


    renderCurrentView();


    statusBox.className =
      "status-box success";


    statusBox.textContent =
      "✅ تم تحميل متابعة الطالبات بنجاح.";


    setTimeout(
      () => {

        statusBox.style.display =
          "none";

      },
      1500
    );


  }catch(error){

    console.error(
      "Student affairs data error:",
      error
    );


    statusBox.className =
      "status-box error";


    statusBox.textContent =
      "تعذر تحميل بيانات الطالبات. تحققي من صلاحية الحساب.";

  }

}


/* =========================
   تصفية الطالبات
========================= */

function getStudentStatus(
  student
){

  if(
    currentView === "semester1"
  ){

    return student.semester1.completed
      ? "completed"
      : "pending";

  }


  if(
    currentView === "semester2"
  ){

    return student.semester2.completed
      ? "completed"
      : "pending";

  }


  return student.nafes.challengeCount ===
    TOTAL_CHALLENGES

      ? "completed"
      : "pending";

}


function getFilteredStudents(){

  const classValue =
    classFilter.value;


  const statusValue =
    statusFilter.value;


  const searchValue =
    searchInput.value
      .trim()
      .toLowerCase();


  return allStudents.filter(
    student => {

      const classMatches =
        classValue === "all" ||
        student.className ===
          classValue;


      const studentStatus =
        getStudentStatus(
          student
        );


      const statusMatches =
        statusValue === "all" ||
        studentStatus ===
          statusValue;


      const searchMatches =
        !searchValue ||
        student.name
          .toLowerCase()
          .includes(
            searchValue
          );


      return (
        classMatches &&
        statusMatches &&
        searchMatches
      );

    }
  );

}


