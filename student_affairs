   الأحداث
========================= */

tabButtons.forEach(
  button => {

    button.addEventListener(
      "click",
      () => {

        currentView =
          button.dataset.view;


        statusFilter.value =
          "all";


        renderCurrentView();

      }
    );

  }
);


classFilter.addEventListener(
  "change",
  renderCurrentView
);


statusFilter.addEventListener(
  "change",
  renderCurrentView
);


searchInput.addEventListener(
  "input",
  renderCurrentView
);


/* =========================
   التحقق من صلاحية الوكيلة
========================= */

onAuthStateChanged(
  auth,
  async user => {


    if(
      !user
    ){

      statusBox.className =
        "status-box error";


      statusBox.textContent =
        "🔒 يلزم تسجيل الدخول بحساب وكيلة شؤون الطالبات لعرض المتابعة.";


      dashboardContent.style.display =
        "none";


      return;

    }


    try{

      statusBox.className =
        "status-box loading";


      statusBox.textContent =
        "جارٍ التحقق من صلاحية حساب وكيلة شؤون الطالبات...";


      const roleRef =
        doc(
          db,
          "user_roles",
          user.uid
        );


      const roleSnap =
        await getDoc(
          roleRef
        );


      if(
        !roleSnap.exists()
      ){

        statusBox.className =
          "status-box error";


        statusBox.textContent =
          "⛔ هذا الحساب غير مفعّل كحساب وكيلة شؤون الطالبات.";


        dashboardContent.style.display =
          "none";


        return;

      }


      const roleData =
        roleSnap.data();


      const role =
        String(
          roleData?.role || ""
        ).trim();


      const roleStatus =
        String(
          roleData?.status || ""
        ).trim();


      if(
        role !== "student_affairs" ||
        roleStatus !== "active"
      ){

        statusBox.className =
          "status-box error";


        statusBox.textContent =
          "⛔ هذه الصفحة مخصصة لحساب وكيلة شؤون الطالبات فقط.";


        dashboardContent.style.display =
          "none";


        return;

      }


      dashboardContent.style.display =
        "block";


      await loadStudents();


    }catch(error){

      console.error(
        "Student affairs role error:",
        error
      );


      statusBox.className =
        "status-box error";


      statusBox.textContent =
        "تعذر التحقق من صلاحية حساب وكيلة شؤون الطالبات الآن.";


      dashboardContent.style.display =
        "none";

    }

  }
);

