/* =========================
   تحديث الصفحة
========================= */

function renderCurrentView(){

  configureView();


  tabButtons.forEach(
    button => {

      button.classList.toggle(
        "active",
        button.dataset.view ===
          currentView
      );

    }
  );


  const students =
    getFilteredStudents()
      .sort(
        (
          first,
          second
        ) =>

          first.className.localeCompare(
            second.className,
            "ar"
          )

          ||

          first.name.localeCompare(
            second.name,
            "ar"
          )
      );


  updateStats(
    students
  );


  if(
    currentView ===
    "semester1"
  ){

    renderSemesterRows(
      students,
      "semester1"
    );

  }


  else if(
    currentView ===
    "semester2"
  ){

    renderSemesterRows(
      students,
      "semester2"
    );

  }


  else{

    renderNafesRows(
      students
    );

  }

}


