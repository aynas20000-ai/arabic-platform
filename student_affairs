/* =========================
   الإحصاءات
========================= */

function updateStats(
  students
){

  stat1.textContent =
    toArabicNumber(
      students.length
    );


  statLabel1.textContent =
    "عدد الطالبات";


  if(
    currentView === "nafes"
  ){

    const completed =
      students.filter(
        student =>
          student.nafes.challengeCount ===
          TOTAL_CHALLENGES
      );


    const pending =
      students.filter(
        student =>
          student.nafes.challengeCount <
          TOTAL_CHALLENGES
      );


    const active =
      students.filter(
        student =>
          student.nafes.challengeCount > 0
      );


    const average =
      active.length > 0

        ? Math.round(
            active.reduce(
              (
                total,
                student
              ) =>
                total +
                student.nafes.challengeAverage,
              0
            ) /
            active.length
          )

        : 0;


    const certificates =
      students.reduce(
        (
          total,
          student
        ) =>
          total +
          student.nafes.certificateCount,
        0
      );


    stat2.textContent =
      toArabicNumber(
        completed.length
      );


    statLabel2.textContent =
      "أكملن نافس";


    stat3.textContent =
      toArabicNumber(
        pending.length
      );


    statLabel3.textContent =
      "يحتجن إكمالًا";


    stat4.textContent =
      toArabicNumber(
        average
      ) + "٪";


    statLabel4.textContent =
      "متوسط نافس";


    stat5.textContent =
      toArabicNumber(
        certificates
      );


    statLabel5.textContent =
      "شهادات نافس";


    return;

  }


  const key =
    currentView ===
      "semester1"

      ? "semester1"
      : "semester2";


  const completed =
    students.filter(
      student =>
        student[key].completed
    );


  const pending =
    students.filter(
      student =>
        !student[key].completed
    );


  const scored =
    students.filter(
      student => {

        if(
          student[key].completed
        ){

          return true;

        }


        return (
          key === "semester2" &&
          student[key].testCount > 0
        );

      }
    );


  const average =
    scored.length > 0

      ? Math.round(
          scored.reduce(
            (
              total,
              student
            ) => {

              if(
                student[key].completed
              ){

                return (
                  total +
                  student[key].score
                );

              }


              return (
                total +
                student[key].currentAverage
              );

            },
            0
          ) /
          scored.length
        )

      : 0;


  const certificates =
    students.filter(
      student =>
        student[key].certificate
    );


  stat2.textContent =
    toArabicNumber(
      completed.length
    );


  statLabel2.textContent =
    "مكتمل";


  stat3.textContent =
    toArabicNumber(
      pending.length
    );


  statLabel3.textContent =
    "يحتجن إكمالًا";


  stat4.textContent =
    toArabicNumber(
      average
    ) + "٪";


  statLabel4.textContent =
    "متوسط الأداء";


  stat5.textContent =
    toArabicNumber(
      certificates.length
    );


  statLabel5.textContent =
    "استحققن الشهادة";

}


/* =========================
   عرض الفصلين
========================= */

function renderSemesterRows(
  students,
  key
){

  studentsTable.innerHTML =
    "";


  if(
    students.length === 0
  ){

    studentsTable.innerHTML = `
      <tr>
        <td
          colspan="7"
          class="empty"
        >
          لا توجد طالبات مطابقة لخيارات المتابعة الحالية.
        </td>
      </tr>
    `;

    return;

  }


  students.forEach(
    student => {

      const data =
        student[key];


      let scoreValue =
        "—";


      if(
        data.completed
      ){

        scoreValue = `
          <span class="${scoreClass(
            data.score
          )}">
            ${toArabicNumber(
              data.score
            )}٪
          </span>
        `;

      }


      else if(
        key === "semester2" &&
        data.testCount > 0
      ){

        scoreValue = `
          <span class="${scoreClass(
            data.currentAverage
          )}">
            ${toArabicNumber(
              data.currentAverage
            )}٪
          </span>
        `;

      }


      const followStatus =
        data.completed

          ? `
              <span class="tag yes">
                ✅ مكتمل
              </span>
            `

          : `
              <span class="tag attention">
                📌 تحتاج متابعة
              </span>
            `;


      const row =
        document.createElement(
          "tr"
        );


      row.innerHTML = `

        <td class="student-name">
          ${escapeHtml(
            student.name
          )}
        </td>

        <td>
          ${escapeHtml(
            student.className
          )}
        </td>

        <td>
          ${toArabicNumber(
            data.testCount
          )}
        </td>

        <td>
          ${
            data.completed

              ? `
                  <span class="tag yes">
                    مكتمل
                  </span>
                `

              : `
                  <span class="tag pending">
                    غير مكتمل
                  </span>
                `
          }
        </td>

        <td>
          ${scoreValue}
        </td>

        <td>
          ${
            data.certificate

              ? `
                  <span class="tag cup">
                    🎓 مستحقة
                  </span>
                `

              : "—"
          }
        </td>

        <td>
          ${followStatus}
        </td>

      `;


      studentsTable.appendChild(
        row
      );

    }
  );

}
